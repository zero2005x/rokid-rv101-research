<?xml version="1.0" encoding="utf-8"?>
<!-- 相簿卡（重做）：方形封面＋右上項數徽章＋左下標題／副標＋選取勾選圈 -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.RokidPhone.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 封面底圖（無封面時顯示） -->
        <View
            android:id="@+id/vCoverBg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_cover_placeholder"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 無封面時的中央圖示 -->
        <ImageView
            android:id="@+id/ivEmpty"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:alpha="0.55"
            android:contentDescription="@string/empty_media"
            android:src="@drawable/ic_image"
            app:layout_constraintBottom_toBottomOf="@id/vCoverBg"
            app:layout_constraintEnd_toEndOf="@id/vCoverBg"
            app:layout_constraintStart_toStartOf="@id/vCoverBg"
            app:layout_constraintTop_toTopOf="@id/vCoverBg"
            app:tint="@color/primary" />

        <!-- 項數徽章 -->
        <TextView
            android:id="@+id/tvBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/bg_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="@color/primary"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 選取勾選圈 -->
        <ImageView
            android:id="@+id/ivCheck"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_margin="8dp"
            android:contentDescription="@string/action_select_all"
            android:src="@drawable/ic_check_circle_empty"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/primary" />

        <View
            android:id="@+id/vScrim"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_scrim_bottom"
            app:layout_constraintBottom_toBottomOf="@id/vCoverBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:layout_marginBottom="17dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/vCoverBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:layout_marginBottom="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="@color/on_scrim"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/vCoverBg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
