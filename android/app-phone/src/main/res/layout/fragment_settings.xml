<?xml version="1.0" encoding="utf-8"?>
<!--
  設定分頁：每個分組都是**可折疊卡片**（點標題列展開/收合，狀態記憶於 prefs）。
  收合後只留標題，讓「常用」與「很少改」的設定不會互相干擾。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="16dp">

        <!-- ===== 連線 ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RokidPhone.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:id="@+id/headerConn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.RokidPhone.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sec_connection" />

                    <ImageView
                        android:id="@+id/chevronConn"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/sec_connection"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentConn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swWifi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/btn_wifi_on" />

                    <TextView
                        android:id="@+id/tvWifiHint"
                        style="@style/Widget.RokidPhone.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_switch_hint" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeviceInfo"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minWidth="0dp"
                        android:text="@string/btn_device_info" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 拍攝與權限 ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RokidPhone.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:id="@+id/headerCapture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.RokidPhone.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sec_capture_root" />

                    <ImageView
                        android:id="@+id/chevronCapture"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/sec_capture_root"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentCapture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swSilent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/silent_switch_label" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swGhost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/ghost_switch_label" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swRootAuto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/root_auto_label" />

                    <!-- root 狀態（P0-b 失敗可視化）＋提權度量（P2）：點一下看操作指引 -->
                    <TextView
                        android:id="@+id/tvRootState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingVertical="6dp"
                        android:text="@string/root_state_unknown"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvRootMetrics"
                        style="@style/Widget.RokidPhone.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAcquireRoot"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:minWidth="0dp"
                        android:text="@string/btn_acquire_root" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 隱私指示燈 ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RokidPhone.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:id="@+id/headerLed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.RokidPhone.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sec_led_settings" />

                    <ImageView
                        android:id="@+id/chevronLed"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/sec_led_settings"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentLed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.RokidPhone.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/led_colors_hint" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupLedColor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:singleSelection="false">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipLedW"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_white" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipLedG"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_green" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipLedB"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_blue" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipLedR"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_red" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 眼鏡顯示 ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RokidPhone.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:id="@+id/headerDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.RokidPhone.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sec_display" />

                    <ImageView
                        android:id="@+id/chevronDisplay"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/sec_display"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentDisplay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupDisplay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDispConn"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_disp_conn" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDispRoot"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_disp_root" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDispCamera"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_disp_camera" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDispStorage"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_disp_storage" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDispLed"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chip_disp_led" />
                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDispAll"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="@string/btn_disp_all" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDispNone"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="@string/btn_disp_none" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 戒指控制 ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RokidPhone.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:id="@+id/headerRing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.RokidPhone.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sec_ring" />

                    <ImageView
                        android:id="@+id/chevronRing"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/sec_ring"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentRing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swRing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/ring_a_label" />

                    <TextView
                        style="@style/Widget.RokidPhone.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ring_a_hint" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="6dp"
                        android:background="@color/outline" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swRingGlasses"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/ring_b_label" />

                    <TextView
                        style="@style/Widget.RokidPhone.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ring_b_hint" />

                    <TextView
                        android:id="@+id/tvRingStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/ring_status_idle"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvRingGlassesStatus"
                        style="@style/Widget.RokidPhone.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRingLearn"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="@string/ring_learn_btn" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRingPair"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="@string/ring_pair_btn" />
                    </LinearLayout>

                    <TextView
                        style="@style/Widget.RokidPhone.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ring_hint" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 外觀（淺色模式） ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RokidPhone.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:id="@+id/headerAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.RokidPhone.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sec_appearance" />

                    <ImageView
                        android:id="@+id/chevronAppearance"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/sec_appearance"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentAppearance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swLight"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/light_mode_label" />

                    <TextView
                        style="@style/Widget.RokidPhone.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/light_mode_hint" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 語言 ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.RokidPhone.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <LinearLayout
                    android:id="@+id/headerLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="40dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Widget.RokidPhone.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/sec_language" />

                    <ImageView
                        android:id="@+id/chevronLang"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/sec_language"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contentLang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLanguage"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/btn_language" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
